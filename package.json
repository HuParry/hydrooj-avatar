{
  "name": "hydrooj-avatar",
  "version": "1.2.0",
  "description": "Hydro OJ square avatar cropping with HEIC support and automatic image attachment compression",
  "main": "index.js",
  "type": "commonjs",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuParry/hydrooj-avatar.git"
  },
  "homepage": "https://github.com/HuParry/hydrooj-avatar#readme",
  "bugs": {
    "url": "https://github.com/HuParry/hydrooj-avatar/issues"
  },
  "preferUnplugged": true,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "avatar/",
    "image-compress/",
    "frontend/",
    "templates/home_settings.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "benchmark": "node test/benchmark.cjs",
    "check:publish": "npm test && npm pack --dry-run --ignore-scripts --workspaces=false"
  },
  "dependencies": {
    "heic-decode": "2.1.0",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "hydrooj": ">=5.1.0",
    "@hydrooj/ui-default": ">=4.59.0"
  },
  "peerDependenciesMeta": {
    "hydrooj": {
      "optional": true
    },
    "@hydrooj/ui-default": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.25.2",
    "jquery": "3.7.1",
    "jsdom": "26.1.0",
    "nunjucks": "3.2.4"
  },
  "keywords": [
    "hydrooj",
    "hydro",
    "plugin",
    "avatar",
    "heic",
    "image-compression"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
